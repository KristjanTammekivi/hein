{
  "name": "hein",
  "description": "Assertion library written in TypeScript",
  "version": "2.0.0-alpha.3",
  "type": "module",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KristjanTammekivi/hein"
  },
  "homepage": "https://heinjs.com",
  "keywords": [
    "typescript",
    "assertion",
    "assert",
    "test",
    "testing"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assert": {
      "import": "./dist/assert.js",
      "require": "./dist/assert.cjs"
    },
    "./expect.types": {
      "import": "./dist/expect.types.js",
      "require": "./dist/expect.types.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "assert": [
        "dist/assert"
      ],
      "expect.types": [
        "dist/expect.types"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --trace-warnings node_modules/.bin/mocha 'src/**/*.test.ts'",
    "test:watch": "node --trace-warnings node_modules/.bin/mocha --watch 'src/**/*.test.ts'",
    "coverage": "nyc npm run test",
    "generate-docs": "typedoc --out docs src/index.ts"
  },
  "author": "Kristjan Tammekivi",
  "license": "MIT",
  "dependencies": {
    "hein-assertion-utils": "^2.0.0-alpha.3",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^24.5.0",
    "eslint": "^9.35.0",
    "eslint-config-hein": "^2.0.0-alpha.0",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "rimraf": "^5.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "tsdown": "^0.15.2",
    "typedoc": "^0.28.9",
    "typescript": "^5.9.2"
  }
}
