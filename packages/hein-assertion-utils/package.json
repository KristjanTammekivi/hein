{
  "name": "hein-assertion-utils",
  "description": "Helpers for creating hein assertions",
  "version": "2.0.0-alpha.3",
  "repository": {
    "type": "git",
    "directory": "packages/hein-assertion-utils",
    "url": "git+https://github.com/KristjanTammekivi/hein.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": "Kristjan Tammekivi",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "yarn run lint -- --fix",
    "test": "mocha src/**/test.ts",
    "test:watch": "npm run test -- --watch"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "eslint-config-hein": "^2.0.0",
    "mocha": "^11.7.1",
    "ts-node": "^10.9.1",
    "tsdown": "^0.15.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "eta": "^3.5.0",
    "lodash": "^4.17.21"
  }
}
